---
import PostCard from '../../components/PostCard.astro';
import BlogShell from '../../layouts/BlogShell.astro';
import { getPosts } from '../../lib/posts';

const posts = await getPosts();
---

<BlogShell title="Blog · Accreleus" description="Development updates from Accreleus: Quasar and the tools around it.">
	<h1>Blog</h1>
	<p class="lede">Development updates on Quasar and the tools around it.</p>

	{posts.length === 0 && <p class="empty">No posts yet.</p>}

	<ul class="posts">
		{
			posts.map((post) => (
				<li>
					<PostCard post={post} />
				</li>
			))
		}
	</ul>
</BlogShell>

<style>
	h1 {
		font-size: 1.9rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		line-height: 1.2;
		margin: 0 0 0.5rem;
	}
	.lede {
		color: var(--q-text-2);
		margin: 0 0 2.5rem;
		font-size: 1.05rem;
	}
	.empty {
		color: var(--q-text-3);
	}
	.posts {
		display: grid;
		gap: 0.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
</style>
