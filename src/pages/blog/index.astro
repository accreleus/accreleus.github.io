---
import BlogShell from '../../layouts/BlogShell.astro';
import { formatDate, getPosts, postUrl, projectNames } from '../../lib/posts';

const posts = await getPosts();
---

<BlogShell title="Blog · Accreleus" description="Development updates from Accreleus: Quasar and the tools around it.">
	<h1>Blog</h1>
	<p class="lede">Development updates on Quasar and the tools around it.</p>

	{posts.length === 0 && <p class="empty">No posts yet.</p>}

	<ul class="posts">
		{
			posts.map((post) => (
				<li>
					<a class="card" href={postUrl(post)}>
						<p class="meta">
							<time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
							{post.data.projects.map((p) => <span class="tag">{projectNames[p]}</span>)}
							{post.data.draft && <span class="tag draft">Draft</span>}
						</p>
						<h2>{post.data.title}</h2>
						<p class="desc">{post.data.description}</p>
					</a>
				</li>
			))
		}
	</ul>
</BlogShell>

<style>
	h1 {
		font-size: 1.9rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		line-height: 1.2;
		margin: 0 0 0.5rem;
	}
	.lede {
		color: var(--q-text-2);
		margin: 0 0 2.5rem;
		font-size: 1.05rem;
	}
	.empty {
		color: var(--q-text-3);
	}
	.posts {
		display: grid;
		gap: 0.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	/* The org landing page's project card. */
	.card {
		display: block;
		padding: 1.1rem 1.25rem;
		border: 1px solid var(--q-line);
		border-radius: var(--q-r-lg);
		background: var(--q-ink-2);
		text-decoration: none;
		color: inherit;
		transition:
			border-color 0.15s ease,
			background 0.15s ease;
	}
	.card:hover,
	.card:focus-visible {
		border-color: var(--q-line-2);
		background: var(--q-ink-3);
	}
	.card h2 {
		margin: 0 0 0.2rem;
		font-size: 1.05rem;
		font-weight: 600;
	}
	.desc {
		margin: 0;
		color: var(--q-text-3);
		font-size: 0.925rem;
	}
	.meta {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin: 0 0 0.4rem;
		color: var(--q-text-3);
		font-size: 0.8125rem;
	}
	.tag {
		padding: 0.05rem 0.5rem;
		border: 1px solid var(--q-line-2);
		border-radius: var(--q-r-sm);
		color: var(--q-text-2);
	}
	.draft {
		color: var(--q-warning-text);
	}
	@media (prefers-reduced-motion: reduce) {
		.card {
			transition: none;
		}
	}
</style>
