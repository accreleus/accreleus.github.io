---
import PostCard from '../components/PostCard.astro';
import Base from '../layouts/Base.astro';
import { getPosts } from '../lib/posts';

const [latest] = await getPosts();
---

<Base title="Accreleus" description="Self-hostable cloud gaming, and the tools around it.">
	<div class="landing">
		<main>
			<header>
				<img src="/mark.svg" alt="" aria-hidden="true" />
				<h1>Accreleus</h1>
			</header>
			<p class="lede">Self-hostable cloud gaming, and the tools around it.</p>
			<ul class="projects">
				<li>
					<a class="card" href="https://accreleus.github.io/quasar/">
						<h2>Quasar &rarr;</h2>
						<p>
							A cloud-gaming platform you run yourself. Stream a GPU host to a browser over WebRTC, on your own
							hardware. Documentation and install guide.
						</p>
					</a>
				</li>
			</ul>
			{
				latest && (
					<section class="latest" aria-label="Latest blog post">
						<p class="label">Latest post</p>
						<PostCard post={latest} />
					</section>
				)
			}
			<nav class="actions" aria-label="More">
				<a class="btn" href="/blog/">
					Blog
					<!-- v3 icon set: chev -->
					<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
						<path d="M6 3.5L10.5 8 6 12.5" stroke-linecap="round" stroke-linejoin="round"></path>
					</svg>
				</a>
				<a class="btn btn-ghost" href="https://github.com/accreleus/quasar" title="Quasar source on GitHub">
					<!-- GitHub's own mark (Octicons mark-github); brand marks are not redrawn. -->
					<svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
						<path
							d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z"
						></path>
					</svg>
					GitHub
				</a>
				<a class="btn btn-ghost btn-ico" href="/blog/rss.xml" aria-label="Blog RSS feed" title="Blog RSS feed">
					<!-- Drawn on the v3 icon grid: 16px box, 1.5 stroke, round caps. -->
					<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
						<circle cx="4" cy="12" r="1.25" fill="currentColor" stroke="none"></circle>
						<path d="M3 7.5a5.5 5.5 0 0 1 5.5 5.5M3 3a10 10 0 0 1 10 10" stroke-linecap="round"></path>
					</svg>
				</a>
			</nav>
		</main>
	</div>
</Base>

<style>
	.landing {
		min-height: 100vh;
		display: grid;
		place-items: center;
		padding: 2rem;
	}
	main {
		width: 100%;
		max-width: 38rem;
	}
	header {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin-bottom: 2rem;
	}
	/* The Accreleus master symbol is 1200x720. Size by height and let width
	   follow, or the crescent and its horizontal lens get squashed. */
	header img {
		height: 64px;
		width: auto;
		flex: none;
		margin-left: -6px;
	}
	h1 {
		font-family: var(--q-font-brand);
		font-size: 1.6rem;
		letter-spacing: 0.02em;
		margin: 0;
		font-weight: 400;
	}
	.lede {
		color: var(--q-text-2);
		margin: 0 0 2.5rem;
		font-size: 1.05rem;
	}
	.projects {
		display: grid;
		gap: 0.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.card {
		display: block;
		padding: 1.1rem 1.25rem;
		border: 1px solid var(--q-line);
		border-radius: 12px;
		background: var(--q-ink-2);
		text-decoration: none;
		color: inherit;
		transition:
			border-color 0.15s ease,
			background 0.15s ease;
	}
	.card:hover,
	.card:focus-visible {
		border-color: var(--q-line-2);
		background: var(--q-ink-3);
	}
	.card h2 {
		margin: 0 0 0.2rem;
		font-size: 1rem;
		font-weight: 600;
	}
	.card p {
		margin: 0;
		color: var(--q-text-3);
		font-size: 0.925rem;
	}
	.latest {
		margin-top: 2rem;
	}
	.label {
		margin: 0 0 0.5rem;
		color: var(--q-text-3);
		font-size: var(--q-t-sm);
	}
	.actions {
		margin-top: 2.5rem;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
	}
	/* v3 .btn / .btn-ghost / .btn-ico, from the Quasar v3 contract. */
	.btn {
		display: inline-flex;
		align-items: center;
		gap: 7px;
		height: var(--q-control-h);
		padding: 0 13px;
		border: 1px solid var(--q-line-3);
		border-radius: var(--q-r-sm);
		background: var(--q-glass-control);
		backdrop-filter: blur(14px) saturate(115%);
		-webkit-backdrop-filter: blur(14px) saturate(115%);
		box-shadow:
			inset 0 1px 0 oklch(0.9618 0.0086 247.91 / 0.12),
			0 1px 2px oklch(0.05 0.01 267 / 0.38),
			0 6px 14px -10px oklch(0.05 0.01 267 / 0.8);
		color: var(--q-text);
		font-size: var(--q-t-sm);
		font-weight: 600;
		letter-spacing: 0.02em;
		text-decoration: none;
		white-space: nowrap;
		transition: 0.16s;
	}
	.btn svg {
		width: 15px;
		height: 15px;
	}
	.btn:hover {
		background: var(--q-glass-control-hover);
		border-color: var(--q-text-2);
		transform: translateY(-1px);
	}
	.btn:active {
		box-shadow: inset 0 2px 4px oklch(0.05 0.01 267 / 0.55);
		transform: translateY(1px);
	}
	.btn-ghost {
		background: transparent;
		backdrop-filter: none;
		-webkit-backdrop-filter: none;
		border-color: transparent;
		box-shadow: none;
		color: var(--q-text-2);
	}
	.btn-ghost:hover {
		background: transparent;
		border-color: var(--q-line-2);
		color: var(--q-text);
	}
	.btn-ico {
		width: var(--q-control-h);
		padding: 0;
		justify-content: center;
	}
	@media (prefers-reduced-motion: reduce) {
		.card,
		.btn {
			transition: none;
		}
		.btn:hover,
		.btn:active {
			transform: none;
		}
	}
</style>
