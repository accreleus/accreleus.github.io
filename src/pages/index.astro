---
import Base from '../layouts/Base.astro';
---

<Base title="Accreleus" description="Self-hostable cloud gaming, and the tools around it.">
	<div class="landing">
		<main>
			<header>
				<img src="/mark.svg" alt="" aria-hidden="true" />
				<h1>Accreleus</h1>
			</header>
			<p class="lede">Self-hostable cloud gaming, and the tools around it.</p>
			<ul class="projects">
				<li>
					<a class="card" href="https://accreleus.github.io/quasar/">
						<h2>Quasar &rarr;</h2>
						<p>
							A cloud-gaming platform you run yourself. Stream a GPU host to a browser over WebRTC, on your own
							hardware. Documentation and install guide.
						</p>
					</a>
				</li>
			</ul>
			<p class="links">
				<a href="/blog/">Blog</a>
				<a href="https://github.com/accreleus">GitHub</a>
				<a href="https://github.com/accreleus/quasar">Quasar source</a>
			</p>
		</main>
	</div>
</Base>

<style>
	.landing {
		min-height: 100vh;
		display: grid;
		place-items: center;
		padding: 2rem;
	}
	main {
		width: 100%;
		max-width: 38rem;
	}
	header {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin-bottom: 2rem;
	}
	/* The Accreleus master symbol is 1200x720. Size by height and let width
	   follow, or the crescent and its horizontal lens get squashed. */
	header img {
		height: 64px;
		width: auto;
		flex: none;
		margin-left: -6px;
	}
	h1 {
		font-family: var(--q-font-brand);
		font-size: 1.6rem;
		letter-spacing: 0.02em;
		margin: 0;
		font-weight: 400;
	}
	.lede {
		color: var(--q-text-2);
		margin: 0 0 2.5rem;
		font-size: 1.05rem;
	}
	.projects {
		display: grid;
		gap: 0.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.card {
		display: block;
		padding: 1.1rem 1.25rem;
		border: 1px solid var(--q-line);
		border-radius: 12px;
		background: var(--q-ink-2);
		text-decoration: none;
		color: inherit;
		transition:
			border-color 0.15s ease,
			background 0.15s ease;
	}
	.card:hover,
	.card:focus-visible {
		border-color: var(--q-line-2);
		background: var(--q-ink-3);
	}
	.card h2 {
		margin: 0 0 0.2rem;
		font-size: 1rem;
		font-weight: 600;
	}
	.card p {
		margin: 0;
		color: var(--q-text-3);
		font-size: 0.925rem;
	}
	.links {
		margin-top: 2.5rem;
		display: flex;
		gap: 1.25rem;
		font-size: 0.9rem;
	}
	.links a {
		color: var(--q-accent-text);
		text-decoration: none;
	}
	.links a:hover {
		text-decoration: underline;
	}
	@media (prefers-reduced-motion: reduce) {
		.card {
			transition: none;
		}
	}
</style>
